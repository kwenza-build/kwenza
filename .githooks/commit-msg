#!/usr/bin/env bash
# Enforces Conventional Commits (https://www.conventionalcommits.org/) on the
# commit subject line. Activate once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

commit_msg_file="$1"
subject="$(head -1 "$commit_msg_file")"

# Let merge commits and fixup!/squash! commits (interactive rebase workflows) through untouched.
if [[ "$subject" =~ ^Merge ]] || [[ "$subject" =~ ^(fixup|squash)\! ]]; then
    exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-zA-Z0-9_-]+\))?!?: .+'

if [[ ! "$subject" =~ $pattern ]]; then
    echo "error: commit message does not follow Conventional Commits" >&2
    echo "  got:      $subject" >&2
    echo "  expected: <type>[(scope)][!]: <description>" >&2
    echo "  types:    feat fix docs style refactor perf test chore build ci revert" >&2
    echo "  example:  feat(resolver): add BOM import support" >&2
    exit 1
fi
