# Build output (kwenza, Maven, and Gradle all rebuild these from source)
/target/
**/target/
**/build/

# kwenza's own bootstrap jar (bootstrap.sh) - regenerable, kept outside target/ on purpose so
# `kwenza clean` never deletes it
/.bootstrap/

# Gradle project-local state - benchmarks always use an isolated GRADLE_USER_HOME instead
**/.gradle/

# Isolated, regenerable dependency caches used by benchmarks/Bench.java
benchmarks/*/.cache/

# macOS
.DS_Store
